# Toss Open API (recommended broker path)
TOSS_CLIENT_ID=your_client_id
TOSS_CLIENT_SECRET=your_client_secret
# Required when more than one brokerage account is returned.
TOSS_ACCOUNT_SEQ=
# Keep false through read-only checks and a separately approved tiny live test.
TOSS_ENABLE_LIVE_ORDERS=false

# Optional legacy KIS path
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT=01
KIS_MODE=paper

# Optional LLM news assessment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safe default: simulation until explicitly changed.
BOT_BROKER=mock

# Optional alerting and heartbeat location
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BOT_HEARTBEAT_DIR=runtime/heartbeats
